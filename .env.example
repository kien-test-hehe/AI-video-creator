CINEFORGE_COMFY_INPUT=
CINEFORGE_DIRECTOR_URL=http://127.0.0.1:11434/v1
CINEFORGE_DIRECTOR_MODEL=
CINEFORGE_DOCKER=docker
CINEFORGE_WANGP_IMAGE=
