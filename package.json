{
  "name": "cineforge-local",
  "version": "0.2.0",
  "private": true,
  "description": "Codex + CapCut film OS with WanGP-first local AI generation and deterministic project state",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "node --experimental-strip-types scripts/core-smoke.ts",
    "lint": "eslint .",
    "workflows:fetch": "node scripts/fetch-reference-workflows.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.70.1",
    "@typescript-eslint/parser": "8.70.1",
    "@vitejs/plugin-react": "5.1.4",
    "electron": "44.4.5",
    "electron-vite": "5.0.0",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.16 <23",
    "npm": ">=10 <11"
  },
  "packageManager": "npm@10.9.2"
}
