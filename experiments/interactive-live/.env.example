# All services are local to this Ubuntu computer.
HOST=127.0.0.1
PORT=8787
LIVE_MODE=0
# Set a long random token and use LIVE_MODE=1 for real event ingestion.
EVENT_TOKEN=
STATE_FILE=.local/state.json
WORLD_FILE=.local/world.json
ASSET_DIR=.local/assets

# Optional read-only TikTok event connector (do not put a password/session cookie here).
TIKTOK_USERNAME=

# Optional AI narrator (off by default; local Ollama OpenAI-compatible endpoint example).
AI_ENABLED=0
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_MODEL=
AI_API_KEY=
# To use a remote provider, opt in separately and consider user message privacy.
AI_ALLOW_REMOTE=0

# Optional offline speech generation using Piper CLI, requires executable and model file.
PIPER_MODEL=
PIPER_BIN=piper

# OBS WebSocket v5 (enable server/authentication in OBS Tools -> WebSocket Server Settings).
OBS_WS_URL=ws://127.0.0.1:4455
OBS_WS_PASSWORD=
OBS_ALLOW_STREAM_CONTROL=0
